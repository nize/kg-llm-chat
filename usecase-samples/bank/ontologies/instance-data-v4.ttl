@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .

###############################################################################
# Reporting periods
###############################################################################

ex:Period_2025_Q1
    a fibo-doc:ReportingPeriod ;
    rdfs:label "2025-Q1"@en ;
    fibo-doc:hasIntervalDescription "2025-01-01 – 2025-03-31" .

ex:Period_2025_Q2
    a fibo-doc:ReportingPeriod ;
    rdfs:label "2025-Q2"@en ;
    fibo-doc:hasIntervalDescription "2025-04-01 – 2025-06-30" .

###############################################################################
# Legal entity (GLEIF LEI)
###############################################################################

gleif:L-NHBDILHZTYCNBV5UYZ31
    rdfs:label "Svenska Handelsbanken AB"@en .

