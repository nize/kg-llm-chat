# === Mongo / Redis ===
MONGO_URI=mongodb://mongo:27017/librechat?replicaSet=rs0&readPreference=primary&retryWrites=true&w=majority
MONGO_URI_TEST=mongodb://mongo:27017/librechatTest?replicaSet=rs0&readPreference=primary&retryWrites=true&w=majority
REDIS_URI=redis://redis:6379

# === LibreChat secrets ===
JWT_SECRET=change_me_hex_32bytes
JWT_REFRESH_SECRET=change_me_hex_32bytes
ENCRYPTION_KEY=change_me_base64_32bytes

# === Model / MCP keys ===
OPENAI_API_KEY=sk-...
QDRANT_API_KEY=...

# === LibreChat endpoints ===
ENDPOINTS=openai,agents

ALLOW_REGISTRATION=true            # email/password sign‑ups
ALLOW_SOCIAL_REGISTRATION=true     # sign‑ups via OAuth providers
ALLOW_SOCIAL_LOGIN=true            # let users log in with those providers
ALLOW_EMAIL_LOGIN=true             # (optional) allow email/password login